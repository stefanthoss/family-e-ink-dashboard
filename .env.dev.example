# Required. One or more calendar feeds, separated by "|".
ICS_URL=https://calendar.google.com/calendar/ical/CHANGE_ME/basic.ics

# Required. https://openweathermap.org/api/one-call-3
OWM_API_KEY=CHANGE_ME

# Required. For the weather.
LAT=37.7749
LNG=-122.4194

# Optional, one entry per feed of ICS_URL and in the same order.
ICS_PREFIX=|School:
ICS_HIDE_LOCATION=false

# Optional.
DISPLAY_TZ=America/Los_Angeles
LOG_LEVEL=DEBUG
WEATHER_UNITS=metric
